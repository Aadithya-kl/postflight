{
  "name": "@postflight/cli",
  "version": "1.0.0",
  "description": "Zero-dependency CLI & local Web Studio launcher for PostFlight social media pre-flight linting, compilation, safe-zone checking, and governance.",
  "type": "module",
  "bin": {
    "postflight": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@postflight/core": "*"
  },
  "license": "MIT",
  "homepage": "https://github.com/prateeekranga/postflight/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prateeekranga/postflight.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/prateeekranga/postflight/issues"
  },
  "author": "prateeekranga (https://github.com/prateeekranga)",
  "keywords": [
    "social-media",
    "cli",
    "linter",
    "sarif",
    "ci",
    "github-actions",
    "preflight",
    "safe-zone",
    "ffmpeg",
    "utm",
    "wcag",
    "ftc-compliance"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
